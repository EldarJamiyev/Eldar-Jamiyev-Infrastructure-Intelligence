# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Environment & Secrets (Never commit production credentials)
.env
.env.local
.env.*.local

# Backups & Archives
backups/
EJI-Platform/
*.zip
*.backup-*
*.bak
*.bak.*

# Ignore local SQLite databases and runtime data
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
