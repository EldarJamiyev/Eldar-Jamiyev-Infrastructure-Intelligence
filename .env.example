# ==============================================================================
# EJII — Eldar Jamiyev's Infrastructure Intelligence
# Environment Configuration Template (.env.example)
#
# Copy this file to .env or .env.local and populate with your environment secrets.
# NEVER commit production secrets or real passwords to version control.
# ==============================================================================

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=production

# Network Binding Configuration
# Security Note: Default 127.0.0.1 restricts access strictly to the local machine.
EJII_HOST=127.0.0.1
EJII_PORT=8443

# Dedicated Persistent Data Directory
# Location for SQLite database, audit trails, and learned telemetry baselines.
# Defaults to ./data within the project directory if left unset.
EJII_DATA_DIR=./data

# Cryptographic Signing Secrets (MANDATORY in production, minimum 32 characters)
# Generate with: openssl rand -hex 32
EJII_HMAC_SECRET=PLACEHOLDER_GENERATE_AT_LEAST_32_CHAR_RANDOM_HMAC_KEY
EJII_JWT_SECRET=PLACEHOLDER_GENERATE_AT_LEAST_32_CHAR_RANDOM_JWT_KEY

# Optional Initial Bootstrap Administrator Password
# If left empty on first run, a secure random password will be generated and stored
# in $EJII_DATA_DIR/security/FIRST_RUN_ADMIN_CREDENTIALS.txt
EJII_ADMIN_PASSWORD=

# Evaluation Mode Override (Set to 'false' in production)
EJII_EVALUATION_MODE=false
